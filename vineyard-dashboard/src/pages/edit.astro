---
import MasterLayout from '../layouts/MasterLayout.astro';
import { EditForm } from '../components/edit/EditForm';
---

<MasterLayout title="Map Configuration" hideHeader={true} hideSidebar={true}>
  <div class="px-6 py-10 max-w-7xl mx-auto">
    <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="space-y-4">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.3em] text-stone-400 hover:text-[#228B22] transition-colors group mb-4"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform"><path d="m15 18-6-6 6-6"/></svg>
          Back to Dashboard
        </a>
        <h1 class="text-5xl font-manrope font-extrabold text-stone-800 tracking-tight leading-none">
          Dashboard <span class="text-[#228B22]">Configuration</span>
        </h1>
        <p class="text-stone-500 font-inter font-medium opacity-80 max-w-2xl leading-relaxed">
          Manage your sentinel vineyard zones, GPS centroids, and soil telemetry parameters 
          to ensure Organic Precision across all sectors.
        </p>
      </div>
    </div>

    {/* React Edit Form Component (Client Only to avoid SSR Leaflet crash) */}
    <EditForm client:only="react" />
  </div>
</MasterLayout>
