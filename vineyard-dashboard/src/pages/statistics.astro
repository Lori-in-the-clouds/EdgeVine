---
import MasterLayout from '../layouts/MasterLayout.astro';
import { DashboardStats } from '../components/stats/DashboardStats';
---

<MasterLayout title="Statistics">
  <div class="max-w-6xl mx-auto">
    <header class="mb-8 mt-2">
      <h1 class="text-3xl font-manrope font-bold text-on-surface">
        Predictive Analytics
      </h1>
      <p class="text-on-surface-variant font-inter mt-1">
        Telemetry health data and estimated production insights.
      </p>
    </header>
    
    <DashboardStats client:only="react" />
  </div>
</MasterLayout>
