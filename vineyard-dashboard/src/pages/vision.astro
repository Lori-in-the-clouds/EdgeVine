---
import MasterLayout from '../layouts/MasterLayout.astro';
import { VisionConsole } from '../components/vision/VisionConsole';
---

<MasterLayout title="AI Vision">
	<main className="min-h-screen bg-[#FDFCFB] p-4 md:p-10 font-manrope">
		<div className="max-w-7xl mx-auto space-y-8 py-10">
			{/* Main Console Implementation */}
            <VisionConsole client:load />

		</div>
	</main>
</MasterLayout>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&display=swap');
	
	body {
		font-family: 'Manrope', sans-serif;
	}
</style>
