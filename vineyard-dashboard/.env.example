# Dashboard-local environment.
# Use this when running commands from vineyard-dashboard/, for example:
# npm run dev
#
# Docker Compose reads ../.env instead.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edgevine
POSTGRES_USER=edgevine_user
POSTGRES_PASSWORD=change-me

# Optional alternative to the individual POSTGRES_* variables:
# DATABASE_URL=postgresql://edgevine_user:change-me@localhost:5432/edgevine

ZONE_STALE_MINUTES=30
ZONE_TEMPERATURE_MIN=5
ZONE_TEMPERATURE_MAX=35
ZONE_HUMIDITY_MIN=35
ZONE_MOISTURE_MIN=250

# When running the dashboard outside Docker, point these at uv-created envs.
# Example: ../CV/.venv/bin/python and ../Predictions/.venv/bin/python
# CV_PYTHON=../CV/.venv/bin/python
# PREDICTION_PYTHON=../Predictions/.venv/bin/python
